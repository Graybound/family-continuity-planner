// Cloudflare deploy for the hosted copy at https://whenimgone.grayhek.com/.
// An assets-only Worker: no server code runs, Cloudflare serves dist/ as static
// files. Plans never leave the visitor's browser. See docs/cloudflare.md.
{
  // Rename to "when-im-gone" in the rename pass (docs/cloudflare.md, "Rename").
  "name": "family-continuity-planner",
  "compatibility_date": "2026-11-01",
  "assets": {
    // Built by: npm run build && node scripts/cloudflare-headers.mjs
    "directory": "./dist",
    "not_found_handling": "none"
  },
  // One origin only. Browser storage is per origin, so a second address
  // (workers.dev or a preview URL) would hold a separate, confusing copy of a plan.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "whenimgone.grayhek.com", "custom_domain": true }]
}
