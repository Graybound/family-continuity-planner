{
  "name": "family-continuity-planner",
  "version": "0.2.0",
  "private": true,
  "description": "A private, local-first planner for documenting the practical knowledge your family needs if you are no longer available to help.",
  "license": "MIT",
  "homepage": "https://graybound.github.io/family-continuity-planner/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Graybound/family-continuity-planner"
  },
  "bugs": {
    "url": "https://github.com/Graybound/family-continuity-planner/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/post-build.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "release": "npm run build && node scripts/make-release.mjs",
    "privacy-scan": "node scripts/privacy-scan.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e && npm run privacy-scan"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
